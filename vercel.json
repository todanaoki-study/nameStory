{
    "version": 2,
    "builds": [
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/generate",
            "dest": "server/server.js",
            "methods": [
                "POST"
            ]
        },
        {
            "src": "/introduction",
            "dest": "server/server.js",
            "methods": [
                "POST"
            ]
        },
        {
            "src": "/development",
            "dest": "server/server.js",
            "methods": [
                "POST"
            ]
        },
        {
            "src": "/twist",
            "dest": "server/server.js",
            "methods": [
                "POST"
            ]
        },
        {
            "src": "/conclusion",
            "dest": "server/server.js",
            "methods": [
                "POST"
            ]
        },
        {
            "src": "/(.*)",
            "dest": "/dist/$1"
        }
    ]
}